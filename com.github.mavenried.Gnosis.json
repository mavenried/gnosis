{
    "app-id" : "com.github.mavenried.Gnosis",
    "runtime" : "org.gnome.Sdk",
    "runtime-version" : "49",
    "sdk" : "org.gnome.Sdk",
    "command" : "gnosis",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=xdg-run/speech-dispatcher:ro",
        "--add-policy=Tracker3.dbus:org.freedesktop.Tracker3.Miner.Files=tracker:Documents"
    ],
    "modules" : [
        {
            "name" : "gnosis-foliate",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "dir",
                    "path" : "."
                }
            ]
        }
    ]
}
